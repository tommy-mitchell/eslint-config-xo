{
	"name": "@tommy-mitchell/eslint-config-xo",
	"version": "2.0.0-beta.2",
	"description": "Personal config for XO.",
	"keywords": [
		"nodejs",
		"config",
		"xo"
	],
	"repository": "tommy-mitchell/eslint-config-xo",
	"license": "MIT",
	"author": {
		"name": "Tommy Mitchell",
		"url": "https://tommymitchell.io"
	},
	"sideEffects": false,
	"type": "module",
	"files": [
		"src"
	],
	"exports": {
		"types": "./src/index.d.ts",
		"default": "./src/index.js"
	},
	"scripts": {
		"format": "dprint fmt && xo --fix",
		"lint": "xo",
		"test": "ava"
	},
	"dependencies": {
		"@eslint-react/eslint-plugin": "^3.0.0",
		"@next/eslint-plugin-next": "^16.0.5",
		"eslint-plugin-better-tailwindcss": "^4.3.2",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-perfectionist": "^5.7.0",
		"eslint-plugin-react-refresh": "^0.5.2",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-sort-react-dependency-arrays": "^1.0.0"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "^5.6.1",
		"@tommy-mitchell/dprint-config": "0.6.0",
		"ava": "^7.0.0",
		"dprint": "0.x",
		"execa": "^9.6.0",
		"react": "^19.2.0",
		"tailwindcss": "^4.1.17",
		"tempy": "^3.1.0",
		"typescript": "6.0.2",
		"xo": "~2.0.2"
	},
	"peerDependencies": {
		"dprint": "0.x",
		"react": "19.x",
		"tailwindcss": "4.x",
		"xo": "2.x"
	},
	"peerDependenciesMeta": {
		"dprint": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"tailwindcss": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22"
	},
	"ava": {
		"timeout": "30s"
	}
}

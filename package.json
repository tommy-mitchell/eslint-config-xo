{
	"name": "@tommy-mitchell/eslint-config-xo",
	"version": "2.0.0-beta.11",
	"description": "Personal config for XO.",
	"license": "MIT",
	"repository": "tommy-mitchell/eslint-config-xo",
	"author": "Tommy Mitchell (https://tommymitchell.io)",
	"type": "module",
	"exports": {
		"types": "./src/index.d.ts",
		"default": "./src/index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": "^22.22 || ^24.15 || >=26"
	},
	"scripts": {
		"lint": "xo",
		"format": "dprint fmt && xo --fix",
		"test": "ava"
	},
	"files": [
		"src"
	],
	"keywords": [
		"nodejs",
		"config",
		"xo"
	],
	"dependencies": {
		"@next/eslint-plugin-next": "^16.3.8",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"eslint-config-xo-react": "^0.32.0",
		"eslint-plugin-better-tailwindcss": "^4.7.0",
		"eslint-plugin-perfectionist": "^5.12.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"eslint-plugin-simple-import-sort": "^14.0.0"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tommy-mitchell/dprint-config": "^0.10.0",
		"@tommy-mitchell/tsconfig": "^4.0.0",
		"@types/node": "^22.20",
		"@types/react": "^19.3.0",
		"ava": "^8.0.1",
		"dprint": "^0.60.1",
		"react": "^19.3.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"xo": "~5.0.1"
	},
	"peerDependencies": {
		"dprint": "0.x",
		"react": "19.x",
		"tailwindcss": "4.x",
		"xo": "5.x"
	},
	"peerDependenciesMeta": {
		"dprint": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"tailwindcss": {
			"optional": true
		}
	},
	"ava": {
		"extensions": [
			"ts"
		],
		"timeout": "30s"
	}
}

{
	"name": "@tommy-mitchell/eslint-config-xo",
	"version": "2.0.0-beta.7",
	"description": "Personal config for XO.",
	"keywords": [
		"nodejs",
		"config",
		"xo"
	],
	"repository": "tommy-mitchell/eslint-config-xo",
	"license": "MIT",
	"author": {
		"name": "Tommy Mitchell",
		"url": "https://tommymitchell.io"
	},
	"sideEffects": false,
	"type": "module",
	"files": [
		"src"
	],
	"exports": {
		"types": "./src/index.d.ts",
		"default": "./src/index.js"
	},
	"scripts": {
		"lint": "xo",
		"format": "dprint fmt && xo --fix",
		"test": "ava"
	},
	"dependencies": {
		"@eslint-react/eslint-plugin": "^3.0.0",
		"@next/eslint-plugin-next": "^16.3.7",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"eslint-plugin-better-tailwindcss": "^4.3.2",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-perfectionist": "^5.12.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"eslint-plugin-simple-import-sort": "^14.0.0"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tommy-mitchell/dprint-config": "^0.8.0",
		"@tommy-mitchell/tsconfig": "^4.0.0",
		"@types/node": "^22.20.4",
		"ava": "^8.0.1",
		"dprint": "0.x",
		"react": "^19.3.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"xo": "~5.0.1"
	},
	"peerDependencies": {
		"dprint": "0.x",
		"react": "19.x",
		"tailwindcss": "4.x",
		"xo": "5.x"
	},
	"peerDependenciesMeta": {
		"dprint": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"tailwindcss": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22"
	},
	"ava": {
		"extensions": [
			"ts"
		],
		"timeout": "30s"
	}
}
